{
  "manifest_version": 3,
  "name": "繁简转换复制",
  "version": "1.2.1",
  "description": "选中文字右键，一键复制为台湾繁体。转换全部在本机完成，不联网。",
  "permissions": [
    "contextMenus",
    "scripting",
    "activeTab",
    "clipboardWrite",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116"
}
